# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

*.ino text eol=lf
*.h text eol=lf
*.c text eol=lf
*.ini text eol=lf
*.msq text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.dll binary
*.fzz binary
*.xls binary


*.pdf -text

# Preserve the byte-exact upstream Speeduino hardware baseline. Some upstream
# files (BOM CSV, PDF, zip) contain CRLF or binary bytes and must not be
# normalised; the SHA-256 manifest in hardware/upstream-speeduino/SHA256SUMS
# is the integrity authority.
hardware/upstream-speeduino/** -text
evidence/hardware/*.hex -text
