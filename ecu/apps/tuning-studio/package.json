{
  "name": "opentech-tuning-studio",
  "private": true,
  "license": "GPL-2.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "service": "cargo run --manifest-path ../../Cargo.toml -p studio-service -- --port 8765 --no-loop"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^35.7.5",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "main": "electron/main.cjs"
}
